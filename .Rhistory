geom_col(position = "dodge") +
geom_errorbar(position = position_dodge(width=0.9), width = 0.3) +
labs(x = "Limit (reached = 1)", y = "Range Hours", title = "Average Age of Hunters Who Do (1) or Do Not (0) Meet the Limit") +
theme_bw()
